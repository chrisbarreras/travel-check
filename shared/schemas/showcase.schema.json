{
  "$defs": {
    "AirlineCoverage": {
      "additionalProperties": false,
      "properties": {
        "airline": {
          "maxLength": 3,
          "minLength": 2,
          "type": "string"
        },
        "itineraries": {
          "minimum": 0,
          "type": "integer"
        },
        "note": {
          "default": "",
          "type": "string"
        },
        "sold_passengers": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "airline",
        "itineraries",
        "sold_passengers",
        "note"
      ],
      "title": "AirlineCoverage",
      "type": "object"
    },
    "AirportInfo": {
      "additionalProperties": false,
      "description": "An airport on the showcase map (specs/004-explorer-core FR-001), from airportsdata.",
      "properties": {
        "city": {
          "minLength": 1,
          "type": "string"
        },
        "code": {
          "pattern": "^[A-Z0-9]{3}$",
          "type": "string"
        },
        "lat": {
          "maximum": 90,
          "minimum": -90,
          "type": "number"
        },
        "lon": {
          "maximum": 180,
          "minimum": -180,
          "type": "number"
        },
        "name": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "code",
        "name",
        "city",
        "lat",
        "lon"
      ],
      "title": "AirportInfo",
      "type": "object"
    },
    "Alternative": {
      "additionalProperties": false,
      "description": "A faster comparable itinerary whose feasibility is shown, by the paired interval, to\nbe no more than the margin worse (research R8). Both rates carry their samples\n(Principle I): the alternative may not be in the same file.",
      "properties": {
        "ci_high": {
          "type": "number"
        },
        "ci_low": {
          "type": "number"
        },
        "itinerary_id": {
          "type": "string"
        },
        "minutes_saved": {
          "minimum": 1,
          "type": "integer"
        },
        "rate_other": {
          "$ref": "#/$defs/Rate"
        },
        "rate_this": {
          "$ref": "#/$defs/Rate"
        },
        "shared_days": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "itinerary_id",
        "minutes_saved",
        "rate_this",
        "rate_other",
        "ci_low",
        "ci_high",
        "shared_days"
      ],
      "title": "Alternative",
      "type": "object"
    },
    "Assumptions": {
      "additionalProperties": false,
      "properties": {
        "boarding_cutoff_min": {
          "minimum": 0,
          "type": "integer"
        },
        "buffer_share": {
          "exclusiveMaximum": 1.0,
          "exclusiveMinimum": 0.5,
          "type": "number"
        },
        "faster_margin": {
          "maximum": 0.2,
          "minimum": 0.0,
          "type": "number"
        },
        "faster_min_saving_min": {
          "minimum": 1,
          "type": "integer"
        },
        "min_connection_default_min": {
          "minimum": 0,
          "type": "integer"
        },
        "min_connection_partner_min": {
          "minimum": 0,
          "type": "integer"
        },
        "min_sample_days": {
          "minimum": 1,
          "type": "integer"
        },
        "monthly_min_sample": {
          "minimum": 1,
          "type": "integer"
        },
        "recurrence_threshold": {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        }
      },
      "required": [
        "min_connection_default_min",
        "min_connection_partner_min",
        "boarding_cutoff_min",
        "recurrence_threshold",
        "min_sample_days",
        "monthly_min_sample",
        "buffer_share",
        "faster_margin",
        "faster_min_saving_min"
      ],
      "title": "Assumptions",
      "type": "object"
    },
    "Attribution": {
      "additionalProperties": false,
      "properties": {
        "licence": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "source",
        "text",
        "licence",
        "url"
      ],
      "title": "Attribution",
      "type": "object"
    },
    "Balance": {
      "additionalProperties": false,
      "description": "The showcase's balance (FR-008): the caps, the resulting shares of showcase\ncomparisons by airline and hub (a comparison counts for both itineraries' airlines and\nhubs), the cross-hub share, and any cap curation could not meet. Route shares are in\n``routes[].share_of_showcase``.",
      "properties": {
        "airline_shares": {
          "additionalProperties": {
            "maximum": 1.0,
            "minimum": 0.0,
            "type": "number"
          },
          "type": "object"
        },
        "caps": {
          "$ref": "#/$defs/BalanceCaps"
        },
        "cross_hub_share": {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        "hub_shares": {
          "additionalProperties": {
            "maximum": 1.0,
            "minimum": 0.0,
            "type": "number"
          },
          "type": "object"
        },
        "shortfalls": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "caps",
        "airline_shares",
        "hub_shares",
        "cross_hub_share",
        "shortfalls"
      ],
      "title": "Balance",
      "type": "object"
    },
    "BalanceCaps": {
      "additionalProperties": false,
      "properties": {
        "airline": {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        "cross_hub_min": {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        "hub": {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        "route": {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        }
      },
      "required": [
        "route",
        "airline",
        "hub",
        "cross_hub_min"
      ],
      "title": "BalanceCaps",
      "type": "object"
    },
    "Buffer": {
      "additionalProperties": false,
      "description": "The recommended layover against the scheduled one. ``actual_layover_min`` is the\nmedian scheduled layover; ``scheduled_at_least_share`` is the share of operated days\nwhose scheduled layover was at least the recommendation, since a median hides a layover\nthat varies by day (review round 2).",
      "properties": {
        "actual_layover_min": {
          "minimum": 0,
          "type": "integer"
        },
        "needed_layover_min": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "operated_days": {
          "minimum": 0,
          "type": "integer"
        },
        "scheduled_at_least_share": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "share": {
          "exclusiveMaximum": 1.0,
          "exclusiveMinimum": 0.5,
          "type": "number"
        }
      },
      "required": [
        "share",
        "needed_layover_min",
        "actual_layover_min",
        "scheduled_at_least_share",
        "operated_days"
      ],
      "title": "Buffer",
      "type": "object"
    },
    "ConnectingOption": {
      "additionalProperties": false,
      "properties": {
        "better": {
          "type": "boolean"
        },
        "ci_high": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "ci_low": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "itinerary_id": {
          "type": "string"
        },
        "outbound_dep_local_min": {
          "maximum": 1439,
          "minimum": 0,
          "type": "integer"
        },
        "rate": {
          "$ref": "#/$defs/Rate"
        }
      },
      "required": [
        "itinerary_id",
        "outbound_dep_local_min",
        "rate",
        "better",
        "ci_low",
        "ci_high"
      ],
      "title": "ConnectingOption",
      "type": "object"
    },
    "Coverage": {
      "additionalProperties": false,
      "properties": {
        "airlines": {
          "items": {
            "$ref": "#/$defs/AirlineCoverage"
          },
          "type": "array"
        },
        "hubs": {
          "items": {
            "pattern": "^[A-Z0-9]{3}$",
            "type": "string"
          },
          "type": "array"
        },
        "not_covered": {
          "items": {
            "$ref": "#/$defs/NotCovered"
          },
          "type": "array"
        },
        "period": {
          "$ref": "#/$defs/DataPeriod"
        },
        "routes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "routes",
        "hubs",
        "airlines",
        "period",
        "not_covered"
      ],
      "title": "Coverage",
      "type": "object"
    },
    "DailySeries": {
      "additionalProperties": false,
      "description": "One entry per paired day: offset from the period start, actual slack in whole minutes\n(null for cancelled or diverted days) and an outcome code (F feasible, T too little time,\nC cancelled, D diverted), compact for the transfer-time slider (ADR-0006).",
      "properties": {
        "day_offset": {
          "items": {
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "outcome": {
          "type": "string"
        },
        "slack_min": {
          "items": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": "array"
        }
      },
      "required": [
        "day_offset",
        "slack_min",
        "outcome"
      ],
      "title": "DailySeries",
      "type": "object"
    },
    "DataPeriod": {
      "additionalProperties": false,
      "properties": {
        "db1b_quarters": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "end": {
          "format": "date",
          "type": "string"
        },
        "start": {
          "format": "date",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end",
        "db1b_quarters"
      ],
      "title": "DataPeriod",
      "type": "object"
    },
    "Definition": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string"
        },
        "methodology_anchor": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "key",
        "text",
        "methodology_anchor"
      ],
      "title": "Definition",
      "type": "object"
    },
    "DisruptionNote": {
      "additionalProperties": false,
      "description": "A known event shown beside measured values; never used in a calculation.",
      "properties": {
        "airlines": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "airports": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "end": {
          "format": "date",
          "type": "string"
        },
        "note_id": {
          "type": "string"
        },
        "source_url": {
          "type": "string"
        },
        "start": {
          "format": "date",
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "note_id",
        "start",
        "end",
        "airlines",
        "airports",
        "text",
        "source_url"
      ],
      "title": "DisruptionNote",
      "type": "object"
    },
    "ExcludedDays": {
      "additionalProperties": false,
      "properties": {
        "end_of_period": {
          "minimum": 0,
          "type": "integer"
        },
        "not_connecting": {
          "minimum": 0,
          "type": "integer"
        },
        "quality": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "not_connecting",
        "quality",
        "end_of_period"
      ],
      "title": "ExcludedDays",
      "type": "object"
    },
    "FailureBreakdown": {
      "additionalProperties": false,
      "properties": {
        "cancelled": {
          "minimum": 0,
          "type": "integer"
        },
        "diverted": {
          "minimum": 0,
          "type": "integer"
        },
        "dominant": {
          "enum": [
            "too_little_time",
            "cancelled",
            "diverted",
            "none"
          ],
          "type": "string"
        },
        "too_little_time": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "too_little_time",
        "cancelled",
        "diverted",
        "dominant"
      ],
      "title": "FailureBreakdown",
      "type": "object"
    },
    "FindLeg": {
      "additionalProperties": false,
      "properties": {
        "flight_number": {
          "type": "string"
        },
        "share_of_days": {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        }
      },
      "required": [
        "flight_number",
        "share_of_days"
      ],
      "title": "FindLeg",
      "type": "object"
    },
    "FindParams": {
      "additionalProperties": false,
      "properties": {
        "airlines": {
          "items": {
            "maxLength": 3,
            "minLength": 2,
            "type": "string"
          },
          "type": "array"
        },
        "dest": {
          "pattern": "^[A-Z0-9]{3}$",
          "type": "string"
        },
        "legs": {
          "items": {
            "$ref": "#/$defs/FindLeg"
          },
          "type": "array"
        },
        "origin": {
          "pattern": "^[A-Z0-9]{3}$",
          "type": "string"
        }
      },
      "required": [
        "origin",
        "dest",
        "airlines",
        "legs"
      ],
      "title": "FindParams",
      "type": "object"
    },
    "LandingRef": {
      "additionalProperties": false,
      "properties": {
        "comparison_id": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "route_id": {
          "type": "string"
        }
      },
      "required": [
        "route_id",
        "comparison_id",
        "reason"
      ],
      "title": "LandingRef",
      "type": "object"
    },
    "ManifestRef": {
      "additionalProperties": false,
      "description": "Pointer to manifest.json. Only identities that change the data are here, so the\npublished bytes do not change with every code commit (the commit is in the manifest).",
      "properties": {
        "code_version": {
          "type": "string"
        },
        "config_sha256": {
          "type": "string"
        },
        "manifest": {
          "type": "string"
        }
      },
      "required": [
        "code_version",
        "config_sha256",
        "manifest"
      ],
      "title": "ManifestRef",
      "type": "object"
    },
    "MonthRate": {
      "additionalProperties": false,
      "properties": {
        "month": {
          "type": "string"
        },
        "note_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "paired_days": {
          "minimum": 0,
          "type": "integer"
        },
        "rate": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "ok",
            "insufficient_data",
            "no_flights"
          ],
          "type": "string"
        }
      },
      "required": [
        "month",
        "status",
        "rate",
        "paired_days",
        "note_ids"
      ],
      "title": "MonthRate",
      "type": "object"
    },
    "NotCovered": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "international",
            "two_or_more_stops",
            "separate_tickets",
            "non_reporting_airline",
            "outside_period",
            "not_in_showcase"
          ],
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "text"
      ],
      "title": "NotCovered",
      "type": "object"
    },
    "Rate": {
      "additionalProperties": false,
      "description": "Connection feasibility with its sample. The data period is the file's ``period``.",
      "properties": {
        "count_feasible": {
          "minimum": 0,
          "type": "integer"
        },
        "definition": {
          "const": "connection_feasibility",
          "type": "string"
        },
        "paired_days": {
          "minimum": 0,
          "type": "integer"
        },
        "rate": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "ok",
            "insufficient_data"
          ],
          "type": "string"
        }
      },
      "required": [
        "status",
        "rate",
        "paired_days",
        "count_feasible",
        "definition"
      ],
      "title": "Rate",
      "type": "object"
    },
    "RouteFile": {
      "additionalProperties": false,
      "properties": {
        "comparisons": {
          "items": {
            "$ref": "#/$defs/ShowcaseComparison"
          },
          "type": "array"
        },
        "disruption_notes": {
          "items": {
            "$ref": "#/$defs/DisruptionNote"
          },
          "type": "array"
        },
        "itineraries": {
          "items": {
            "$ref": "#/$defs/ShowcaseItinerary"
          },
          "type": "array"
        },
        "period": {
          "$ref": "#/$defs/DataPeriod"
        },
        "route_id": {
          "type": "string"
        }
      },
      "required": [
        "route_id",
        "period",
        "itineraries",
        "comparisons",
        "disruption_notes"
      ],
      "title": "RouteFile",
      "type": "object"
    },
    "RouteSummary": {
      "additionalProperties": false,
      "properties": {
        "comparison_count": {
          "minimum": 0,
          "type": "integer"
        },
        "dest": {
          "pattern": "^[A-Z0-9]{3}$",
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "itinerary_count": {
          "minimum": 0,
          "type": "integer"
        },
        "nonstop_median_min": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "origin": {
          "pattern": "^[A-Z0-9]{3}$",
          "type": "string"
        },
        "regional_origin": {
          "type": "boolean"
        },
        "route_id": {
          "type": "string"
        },
        "share_of_showcase": {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        }
      },
      "required": [
        "route_id",
        "origin",
        "dest",
        "regional_origin",
        "itinerary_count",
        "comparison_count",
        "share_of_showcase",
        "nonstop_median_min",
        "file"
      ],
      "title": "RouteSummary",
      "type": "object"
    },
    "Schedule": {
      "additionalProperties": false,
      "description": "Median scheduled times. Local minutes are clock times at each airport. The hub arrival\nand the inbound flight's duration (specs/004-explorer-core FR-002) are medians over the\nitinerary's connecting days, the days `layover_min` and `travel_min` use. The hub\ndeparture is the hub arrival plus `layover_min`, and the outbound flight's duration is\n`travel_min` less the inbound flight and the layover, so the parts agree with the totals.",
      "properties": {
        "arr_local_min": {
          "maximum": 1439,
          "minimum": 0,
          "type": "integer"
        },
        "dep_local_min": {
          "maximum": 1439,
          "minimum": 0,
          "type": "integer"
        },
        "hub_arr_local_min": {
          "maximum": 1439,
          "minimum": 0,
          "type": "integer"
        },
        "hub_dep_local_min": {
          "maximum": 1439,
          "minimum": 0,
          "type": "integer"
        },
        "inbound_min": {
          "minimum": 1,
          "type": "integer"
        },
        "layover_min": {
          "minimum": 0,
          "type": "integer"
        },
        "nonstop_median_min": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "nonstop_ratio": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "outbound_min": {
          "minimum": 1,
          "type": "integer"
        },
        "travel_min": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "dep_local_min",
        "arr_local_min",
        "layover_min",
        "travel_min",
        "nonstop_median_min",
        "nonstop_ratio",
        "hub_arr_local_min",
        "hub_dep_local_min",
        "inbound_min",
        "outbound_min"
      ],
      "title": "Schedule",
      "type": "object"
    },
    "ScheduleChange": {
      "additionalProperties": false,
      "properties": {
        "date": {
          "format": "date",
          "type": "string"
        },
        "from_local_min": {
          "maximum": 1439,
          "minimum": 0,
          "type": "integer"
        },
        "leg": {
          "enum": [
            "inbound",
            "outbound"
          ],
          "type": "string"
        },
        "to_local_min": {
          "maximum": 1439,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "date",
        "leg",
        "from_local_min",
        "to_local_min"
      ],
      "title": "ScheduleChange",
      "type": "object"
    },
    "ScheduleWarnings": {
      "additionalProperties": false,
      "description": "The connection share with its sample: connecting days of the eligible days (days in\nthe period less end-of-period days).",
      "properties": {
        "changes": {
          "items": {
            "$ref": "#/$defs/ScheduleChange"
          },
          "type": "array"
        },
